# Copy this file to .env.local and fill in your values

# PostgreSQL connection string from Neon, Supabase, or Railway
# Example Neon: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Secret for protecting the cron endpoint (optional but recommended)
# Generate with: openssl rand -hex 32
CRON_SECRET="your-random-secret-here"
